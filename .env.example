# Copy to .env for local development. Never commit .env.
#
# Values below match `supabase start`'s default local stack exactly — run
# `pnpm db:start` and `pnpm db:status` to confirm, or copy from there if you
# changed supabase/config.toml's ports.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# Bypasses RLS. Required for the capture worker and for integration-test
# fixture setup; never set this in a browser context, and never in any
# environment other than local dev / CI without a specific reason.
SUPABASE_SERVICE_ROLE_KEY=

# Same URL/anon key as above, duplicated under the VITE_ prefix Vite
# requires to expose a variable to browser code (src/ui/env.ts) — the
# service role key has no VITE_ counterpart and must never get one.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
