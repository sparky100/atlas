{
  "name": "atlas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:watch": "vitest --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "content:load-capability-maps": "tsx scripts/loadCapabilityMaps.ts",
    "content:review-capability-maps": "tsx scripts/reviewCapabilityMaps.ts",
    "content:publish-capability-map": "tsx scripts/publishCapabilityMap.ts",
    "check:case-collisions": "tsx scripts/checkCaseCollisions.ts",
    "backfill:commit-titles": "tsx scripts/backfillCommitTitles.ts",
    "backfill:capability-order": "tsx scripts/backfillCapabilityOrder.ts",
    "sync:descriptions": "tsx scripts/syncDescriptionsFromMap.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@supabase/supabase-js": "^2.115.0",
    "@types/node": "^22.10.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^9.36.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "fast-check": "^4.5.0",
    "storybook": "10.6.0",
    "supabase": "^2.116.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0",
    "vite": "8.2.2",
    "vitest": "^3.0.0",
    "zod": "^4.5.0"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.1"
  }
}
