{
  "name": "atlas",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:watch": "vitest --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "release": "tsx scripts/releasePreflight.ts && supabase db push && echo 'Migrations pushed to the live project. Cloudflare Workers Builds deploys the app itself automatically on every git push to main — nothing else to run here.'",
    "content:load-capability-maps": "tsx scripts/loadCapabilityMaps.ts",
    "content:review-capability-maps": "tsx scripts/reviewCapabilityMaps.ts",
    "content:publish-capability-map": "tsx scripts/publishCapabilityMap.ts",
    "content:export-capability-map": "tsx scripts/exportCapabilityMap.ts",
    "content:review-catalogue": "tsx scripts/reviewCatalogue.ts",
    "content:load-catalogue": "tsx scripts/loadCatalogue.ts",
    "content:build-catalogue-import": "tsx scripts/buildCatalogueImport.ts",
    "content:publish-catalogue": "tsx scripts/publishCatalogue.ts",
    "content:inventory": "tsx scripts/referenceInventory.ts",
    "check:case-collisions": "tsx scripts/checkCaseCollisions.ts",
    "backfill:commit-titles": "tsx scripts/backfillCommitTitles.ts",
    "backfill:capability-order": "tsx scripts/backfillCapabilityOrder.ts",
    "backfill:owns-role": "tsx scripts/backfillOwnsRole.ts",
    "sync:descriptions": "tsx scripts/syncDescriptionsFromMap.ts",
    "strip:seed-codes": "tsx scripts/stripSeedCodes.ts",
    "capture:score": "tsx scripts/scoreCapture.ts",
    "ai:eval": "tsx scripts/askEval.ts",
    "mcp": "tsx mcp/src/main.ts",
    "mcp:login": "tsx mcp/src/main.ts login",
    "mcp:status": "tsx mcp/src/main.ts status",
    "mcp:bundle": "tsx scripts/bundleMcp.ts",
    "prebuild": "pnpm mcp:bundle",
    "functions:bundle:capture-run": "tsx scripts/bundleCaptureRunFunction.ts",
    "functions:deploy:capture-run": "pnpm functions:bundle:capture-run && supabase functions deploy capture-run",
    "functions:bundle:ask-model": "tsx scripts/bundleAskModelFunction.ts",
    "functions:bundle:org-ai-key": "tsx scripts/bundleOrgAiKeyFunction.ts",
    "functions:deploy:org-ai-key": "pnpm functions:bundle:org-ai-key && supabase functions deploy org-ai-key",
    "functions:bundle:design-agent": "tsx scripts/bundleDesignAgentFunction.ts",
    "functions:bundle:research-agent": "tsx scripts/bundleResearchAgentFunction.ts",
    "functions:bundle:catalogue-link-check": "tsx scripts/bundleCatalogueLinkCheckFunction.ts",
    "functions:deploy:catalogue-link-check": "pnpm functions:bundle:catalogue-link-check && supabase functions deploy catalogue-link-check --use-api",
    "functions:bundle:review-agent": "tsx scripts/bundleReviewAgentFunction.ts",
    "functions:deploy:review-agent": "pnpm functions:bundle:review-agent && supabase functions deploy review-agent --use-api",
    "functions:deploy:design-agent": "pnpm functions:bundle:design-agent && supabase functions deploy design-agent",
    "functions:deploy:research-agent": "pnpm functions:bundle:research-agent && supabase functions deploy research-agent",
    "functions:deploy:ask-model": "pnpm functions:bundle:ask-model && supabase functions deploy ask-model",
    "functions:bundle:api": "tsx scripts/bundleApiFunction.ts",
    "functions:deploy:api": "pnpm functions:bundle:api && supabase functions deploy api --no-verify-jwt",
    "functions:bundle:connector-fetch": "tsx scripts/bundleConnectorFetchFunction.ts",
    "functions:deploy:connector-fetch": "pnpm functions:bundle:connector-fetch && supabase functions deploy connector-fetch"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@supabase/supabase-js": "^2.115.0",
    "@types/node": "^22.10.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "eslint": "^9.36.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "fast-check": "^4.5.0",
    "storybook": "10.6.0",
    "supabase": "^2.116.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0",
    "vite": "8.2.2",
    "vitest": "^3.0.0",
    "zod": "^4.5.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@noble/hashes": "2.4.0",
    "@tanstack/react-query": "^5.103.1",
    "lucide-react": "^1.47.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.1",
    "xlsx": "^0.18.5"
  }
}
